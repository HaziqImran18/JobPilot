# ---------------------------------------------------------------------------
# JobPilot environment configuration
# Copy this file to `.env` and fill in what you need.
# Chat requires OPENAI_API_KEY. Without it, the app shows a setup page.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
JOBPILOT_ENV=development
JOBPILOT_DEBUG=true
JOBPILOT_HOST=127.0.0.1
JOBPILOT_PORT=5000
# Signs session cookies. Replace with a long random value before exposing the app.
JOBPILOT_SECRET_KEY=change-me-in-production
# How long a signed-in session lasts.
JOBPILOT_SESSION_DAYS=14
# Allow new accounts to be created from /register.
JOBPILOT_ALLOW_REGISTRATION=true

# --- LLM -------------------------------------------------------------------
# REQUIRED for chat. Get a key at https://platform.openai.com/api-keys
# Until this is set, JobPilot shows a setup page instead of pretending to be AI.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint.
# OPENAI_BASE_URL=
JOBPILOT_MODEL_FAST=gpt-4o-mini
JOBPILOT_MODEL_STRONG=gpt-4o
JOBPILOT_EMBEDDING_MODEL=text-embedding-3-small
# auto | openai | hashing | local
# auto stays local and free (hashing). Set "openai" to opt into paid embeddings.
JOBPILOT_EMBEDDING_PROVIDER=auto
# Hard safety limits for development budgets.
JOBPILOT_MAX_BUDGET_USD=2.00
JOBPILOT_DAILY_BUDGET_USD=1.00
JOBPILOT_MAX_STEPS_PER_RUN=12
JOBPILOT_MAX_CONSECUTIVE_FAILURES=3

# --- Storage ---------------------------------------------------------------
# Shared account database; every account gets data/users/<id>/.
JOBPILOT_DATA_DIR=data
JOBPILOT_AUTH_DB_PATH=data/auth.db
# Base paths used by the CLI and tests. The web app redirects them into the
# signed-in account's private workspace automatically.
JOBPILOT_DB_PATH=data/jobpilot.db
JOBPILOT_TRACES_DIR=data/traces
JOBPILOT_UPLOADS_DIR=data/uploads
# Warm the MCP servers for existing accounts at startup. Off by default: each
# account spawns six subprocesses, and they start on first use anyway.
JOBPILOT_PRELOAD_MCP=false

# --- Sources (all free, no API key required) -------------------------------
JOBPILOT_ENABLE_REMOTIVE=true
JOBPILOT_ENABLE_ARBEITNOW=true
JOBPILOT_ENABLE_REMOTEOK=true
JOBPILOT_ENABLE_JOBICY=true
JOBPILOT_ENABLE_HIMALAYAS=true
JOBPILOT_ENABLE_RSS=true
# LinkedIn is disabled by default: automation violates its terms of service.
JOBPILOT_ENABLE_LINKEDIN=false
JOBPILOT_HTTP_TIMEOUT=20
JOBPILOT_USER_AGENT=JobPilot/0.2 (job search agent)

# --- UI --------------------------------------------------------------------
JOBPILOT_DEFAULT_LOCATION=
JOBPILOT_DEFAULT_REMOTE=true
